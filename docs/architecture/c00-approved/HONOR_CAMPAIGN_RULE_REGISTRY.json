    "current_mirror": "provider,campaign_url,external_campaign_id,status,start_at,end_at,deadline_at,last_verified_at are current-query mirrors of campaigns.terms_snapshot_id only; historical decisions read immutable rule rows",
    "native_audio": "platform_native_audio_rules is per-platform ALLOWED|PROHIBITED|UNKNOWN|NOT_APPLICABLE; UNKNOWN/PROHIBITED cannot be escalated by planning/posting snapshots",
    "account_follower_range": "when eligible_account_requirements min_followers and max_followers are both non-null, min_followers <= max_followers"
  },
  "rule_set_seal_contract": {
    "required_rule_count": 32,
    "seal_table": "campaign_rule_set_commits",
    "seal_function": "honor_seal_campaign_rule_set(uuid,uuid,integer)",
    "hash": "DB-computed SHA-256 of PostgreSQL jsonb canonical text for an array ordered by rule_key; each element contains rule_key, knowledge_state, typed_value, evidence_snapshot_id, evidence_locator, verified_at, verified_by, schema_version",
    "temporal_order": [
      "evidence snapshot captured_at/created_at <= verified_at for KNOWN/NOT_APPLICABLE",
      "verified_at <= rule-set committed_at",
      "rule-set committed_at <= consuming DB-authoritative action time"
    ],
    "post_seal_mutation": "no INSERT/UPDATE/DELETE of campaign_rule_items for sealed tuple",
    "reactivation": "a previously superseded snapshot may never become current again; provider reversion requires a newly captured/reverified snapshot and new seal",
    "evidence_record_time": "campaign_terms_snapshots.created_at is DB-authoritative; captured_at is external factual evidence time; both must be <= verified_at for KNOWN/NOT_APPLICABLE"
  },
