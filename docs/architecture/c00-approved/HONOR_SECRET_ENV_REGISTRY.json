{
  "version": 1,
  "credentials": {
    "DATABASE_APP_URL": {
      "classification": "secret",
      "store": "root-owned server runtime env",
      "receivers": [
        "api",
        "worker"
      ]
    },
    "DATABASE_ADMIN_URL": {
      "classification": "secret",
      "store": "root-owned admin/backup env",
      "receivers": [
        "migration",
        "backup",
        "owner-bootstrap"
      ]
    },
    "REDIS_PASSWORD": {
      "classification": "secret",
      "store": "root-owned server runtime env",
      "receivers": [
        "api",
        "worker",
        "celery"
      ]
    },
    "R2_MEDIA_ACCESS_KEY_ID": {
      "classification": "credential-id",
      "store": "root-owned server runtime env",
      "receivers": [
        "api",
        "worker",
        "media"
      ]
    },
    "R2_MEDIA_SECRET_ACCESS_KEY": {
      "classification": "secret",
      "store": "root-owned server runtime env",
      "receivers": [
        "api",
        "worker",
        "media"
      ]
    },
    "R2_BACKUP_ACCESS_KEY_ID": {
      "classification": "credential-id",
      "store": "root-owned backup env",
      "receivers": [
        "backup",
        "restic"
      ]
    },
    "R2_BACKUP_SECRET_ACCESS_KEY": {
      "classification": "secret",
      "store": "root-owned backup env",
      "receivers": [
        "backup",
        "restic"
      ]
    },
    "OPENAI_API_KEY": {
      "classification": "secret",
      "store": "root-owned server runtime env",
      "receivers": [
        "api",
        "worker",
        "polli"
      ]
    },
    "BETTERSTACK_API_TOKEN": {
      "classification": "optional-secret",
      "store": "root-owned monitoring env",
      "receivers": [
        "monitoring-setup-only"
      ]
    },
    "BETTERSTACK_BACKUP_HEARTBEAT_URL": {
      "classification": "secret-url",
      "store": "root-owned backup env",
      "receivers": [
        "backup"
      ]
    },
    "BETTERSTACK_WORKER_HEARTBEAT_URL": {
      "classification": "secret-url",
      "store": "root-owned worker env",
      "receivers": [
        "worker"
      ]
    },
    "RESTIC_PASSWORD": {
      "classification": "secret",
      "store": "root-owned backup env",
      "receivers": [
        "backup",
        "restic"
      ]
    },
    "RUNPOD_API_KEY": {
      "classification": "deferred-secret",
      "store": "unset at launch",
      "receivers": []
    },
    "DEPLOY_SSH_PRIVATE_KEY": {
      "classification": "secret",
      "store": "GitHub Actions repository secret only",
      "receivers": [
        "github-actions-deploy-job"
      ]
    }
  },
  "public_or_nonsecret": {
    "NEXT_PUBLIC_SUPABASE_URL": "public project URL",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "publishable browser key by design",
    "HONOR_OWNER_USER_ID": "non-secret owner UUID; server config/repository variable",
    "OPENAI_PROJECT_ID": "non-secret provider project identifier",
    "DEPLOY_HOST": "repository variable",
    "DEPLOY_SSH_KNOWN_HOSTS": "repository variable"
  },
  "credential_separation_rules": {
    "r2_media_vs_backup": "MUST_USE_SEPARATE_BUCKET_SCOPED_CREDENTIALS",
    "restic_aws_aliases": "AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY exist only inside restic container and map from R2_BACKUP_* host secrets; they are not host .env credentials",
    "browser_forbidden": "No entry in credentials may be shipped as NEXT_PUBLIC_* or client bundle data."
  }
}
