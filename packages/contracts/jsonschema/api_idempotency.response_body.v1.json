{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honor.local/jsonschema/api_idempotency.response_body.v1.json",
  "title": "api_idempotency.response_body.v1",
  "x-honor-contract-class": "STRUCTURED_FROZEN_V1",
  "type": "object",
  "properties": {
    "status_code": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "content_type": {
      "const": "application/json"
    },
    "body_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "body_redacted": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "required": [
    "status_code",
    "content_type",
    "body_sha256",
    "body_redacted"
  ],
  "x-honor-writer": "api"
}
