{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honor.local/jsonschema/analytics_checkin.config.v1.json",
  "title": "analytics_checkin.config.v1",
  "x-honor-contract-class": "STRUCTURED_FROZEN_V1",
  "type": "object",
  "properties": {
    "checkins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "H2",
              "H24",
              "H72",
              "FINAL",
              "CUSTOM"
            ]
          },
          "offset_minutes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 525600
              },
              {
                "type": "null"
              }
            ]
          },
          "due_at_rule": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "POST_OFFSET",
                  "CAMPAIGN_FINAL_WINDOW"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "required": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "required": [
          "type",
          "offset_minutes",
          "due_at_rule",
          "required"
        ]
      },
      "minItems": 1,
      "maxItems": 20
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    }
  },
  "additionalProperties": false,
  "required": [
    "checkins",
    "timezone"
  ],
  "x-honor-writer": "api|worker"
}
