{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honor.local/jsonschema/qc.metrics.v1.json",
  "title": "qc.metrics.v1",
  "x-honor-contract-class": "STRUCTURED_FROZEN_V1",
  "type": "object",
  "properties": {
    "duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "file_size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "integrated_lufs": {
      "anyOf": [
        {
          "type": "number",
          "minimum": -100,
          "maximum": 10
        },
        {
          "type": "null"
        }
      ]
    },
    "true_peak_dbtp": {
      "anyOf": [
        {
          "type": "number",
          "minimum": -100,
          "maximum": 20
        },
        {
          "type": "null"
        }
      ]
    },
    "silence_ratio": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "frozen_frame_ratio": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "black_frame_ratio": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "face_tracking_confidence": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "caption_density_words_per_minute": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        {
          "type": "null"
        }
      ]
    },
    "render_realtime_factor": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "duration_seconds",
    "file_size_bytes",
    "integrated_lufs",
    "true_peak_dbtp",
    "silence_ratio",
    "frozen_frame_ratio",
    "black_frame_ratio",
    "face_tracking_confidence",
    "caption_density_words_per_minute",
    "render_realtime_factor"
  ],
  "x-honor-writer": "media|worker"
}
