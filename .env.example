# HONOR C00 — PLACEHOLDERS ONLY. NEVER COMMIT LIVE .env VALUES.
# Month-1 governor: NORMAL <43.00; OPTIONAL_PAUSED >=43.00,<51.03; RESERVE >=51.03,<56.03; HARD_STOP >=56.03.
# No optional paid work may be admitted at/above 43.00. Every paid action is checked against post-admission exposure before dispatch.
# Prepaid funding counts at purchase; later consumption of the already-counted credit is not double-counted.

# ---------- App / cost governor ----------
HONOR_ENV=development
HONOR_PUBLIC_ORIGIN=https://honor.example.invalid
HONOR_PUBLIC_HOST=:80
HONOR_OWNER_TIMEZONE=America/Chicago
HONOR_OWNER_USER_ID=00000000-0000-0000-0000-000000000000
HONOR_MONTH1_HARD_CAP_USD=56.03
HONOR_OPTIONAL_PAUSE_USD=43.00
HONOR_RESERVE_MODE_USD=51.03
HONOR_TARGET_MONTHLY_REVENUE_USD=4000.00
LOG_LEVEL=INFO

# ---------- Public browser configuration: NON-SECRET release-image BUILD inputs ----------
# Next.js freezes these into browser JS at `next build`; runtime web.env cannot replace them.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
NEXT_PUBLIC_HONOR_BFF_BASE=/api/v1

# ---------- Auth/session server configuration ----------
# AUTH_ROUTE_SET_V1: GET /login | POST /auth/login | POST /auth/recover | GET /auth/confirm | GET /auth/set-password | POST /auth/set-password | POST /auth/logout
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
HONOR_INTERNAL_API_ORIGIN=http://api:8000
HONOR_INTERNAL_LIVENESS_PATH=/healthz
HONOR_INTERNAL_READINESS_PATH=/readyz
HONOR_PUBLIC_HEALTH_PATH=/healthz
HONOR_OWNER_READINESS_PATH=/api/readyz
HONOR_CSRF_COOKIE_NAME=honor_csrf

# No SUPABASE_SECRET_KEY and no SUPABASE_SERVICE_ROLE_KEY are required by V1 runtime.
# Never introduce either into NEXT_PUBLIC_* or browser code.

# ---------- Supabase Postgres: canonical direct IPv6 :5432 from the Droplet ----------
# Normal runtime only: custom least-privilege NOBYPASSRLS role.
DATABASE_APP_URL=postgresql://honor_app:REPLACE_ME@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# ADMIN JOB CONTEXT ONLY: migrations / pg_dump / restore. Never inject into web/api/worker runtime.
DATABASE_ADMIN_URL=postgresql://postgres:REPLACE_ME@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# ---------- Redis / Celery (internal Compose network) ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_ME
REDIS_CACHE_DB=0
CELERY_BROKER_DB=1
CELERY_RESULT_DB=2
# Construct server-side only at runtime; never expose these URLs to browser/logs:
REDIS_URL_TEMPLATE=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_CACHE_DB}
CELERY_BROKER_URL_TEMPLATE=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${CELERY_BROKER_DB}
CELERY_RESULT_BACKEND_TEMPLATE=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${CELERY_RESULT_DB}
HONOR_WORKER_CONCURRENCY=1
HONOR_RECONCILE_INTERVAL_SECONDS=15
HONOR_REDISPATCH_MIN_AGE_SECONDS=30
HONOR_JOB_HEARTBEAT_INTERVAL_SECONDS=20
HONOR_WORKER_MONITOR_INTERVAL_SECONDS=60
HONOR_RECONCILER_HEALTH_TTL_SECONDS=75

# ---------- Cloudflare R2 — separate least-privilege credentials ----------
R2_ACCOUNT_ID=REPLACE_ME
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET_MEDIA=honor-media
R2_BUCKET_BACKUPS=honor-backups
# Runtime media credential: Object Read & Write, scoped ONLY to honor-media. Inject only into API/worker/media containers.
R2_MEDIA_ACCESS_KEY_ID=REPLACE_ME
R2_MEDIA_SECRET_ACCESS_KEY=REPLACE_ME
# Backup credential: Object Read & Write, scoped ONLY to honor-backups. Inject only into backup/restic container.
R2_BACKUP_ACCESS_KEY_ID=REPLACE_ME
R2_BACKUP_SECRET_ACCESS_KEY=REPLACE_ME
R2_PRESIGNED_URL_TTL_SECONDS=300

# ---------- OpenAI ----------
OPENAI_API_KEY=REPLACE_ME
OPENAI_PROJECT_ID=REPLACE_ME
OPENAI_ROUTINE_MODEL=gpt-5.6-luna
OPENAI_DEEP_MODEL=gpt-5.6-terra
OPENAI_SOL_ENABLED=false
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TRANSCRIBE_ESCALATION_MODEL=gpt-transcribe
HONOR_OPENAI_MONTH1_MAX_USD=15.00

# ---------- Media ----------
FFMPEG_BIN=/usr/bin/ffmpeg
FFPROBE_BIN=/usr/bin/ffprobe
MEDIA_RENDER_CONCURRENCY=1
MEDIA_TEMP_MAX_GB=12
MEDIA_TARGET_LUFS=-15
MEDIA_TRUE_PEAK_DBTP=-1.0
HONOR_UPLOAD_MAX_BYTES=2147483648

# ---------- Better Stack / monitoring ----------
BETTERSTACK_API_TOKEN=optional-REPLACE_ME
BETTERSTACK_BACKUP_HEARTBEAT_URL=https://uptime.betterstack.com/api/v1/heartbeat/REPLACE_ME
BETTERSTACK_WORKER_HEARTBEAT_URL=https://uptime.betterstack.com/api/v1/heartbeat/REPLACE_ME

# ---------- Restic backup ----------
RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/honor-backups
RESTIC_PASSWORD=REPLACE_ME
# Docker Compose maps backup-only host variables into restic's expected names:
# AWS_ACCESS_KEY_ID=${R2_BACKUP_ACCESS_KEY_ID}
# AWS_SECRET_ACCESS_KEY=${R2_BACKUP_SECRET_ACCESS_KEY}
# AWS_DEFAULT_REGION=auto

# ---------- Optional burst GPU — DISABLED at launch ----------
GPU_PROVIDER=disabled
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# ---------- Deployment: GitHub Actions repository secrets / variables, not browser env ----------
# Repository secret:
DEPLOY_SSH_PRIVATE_KEY=REPLACE_ME
# Repository variables (non-secret deployment metadata):
DEPLOY_HOST=REPLACE_ME
DEPLOY_SSH_KNOWN_HOSTS=REPLACE_ME
DEPLOY_USER=honor
DEPLOY_PATH=/opt/honor

# First-deploy owner-bootstrap only; not a runtime receiver and never committed with a live value.
HONOR_APP_DB_PASSWORD=REPLACE_ME_MIN_32_CHARS
