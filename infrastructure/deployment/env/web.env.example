# Runtime-only Next.js server configuration. NEXT_PUBLIC_* is intentionally absent:
# those three values are frozen into each release image by explicit Docker build args.
NODE_ENV=production
SUPABASE_URL=https://PROJECT_REF.supabase.co
HONOR_PUBLIC_ORIGIN=https://honor.example.invalid
HONOR_OWNER_USER_ID=00000000-0000-0000-0000-000000000000
HONOR_INTERNAL_API_ORIGIN=http://api:8000
HONOR_CSRF_COOKIE_NAME=honor_csrf
